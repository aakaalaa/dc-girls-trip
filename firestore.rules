rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /flightVotes/{voteId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['name', 'departureFlightId', 'returnFlightId', 'note', 'timestamp'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 100
                    && request.resource.data.departureFlightId is string
                    && request.resource.data.departureFlightId.size() > 0
                    && request.resource.data.returnFlightId is string
                    && request.resource.data.returnFlightId.size() > 0
                    && request.resource.data.note is string
                    && request.resource.data.note.size() < 1000
                    && request.resource.data.timestamp is string;

      allow update: if false;

      // Anyone with the link can reset votes (matches the app's "Reset" button).
      allow delete: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
